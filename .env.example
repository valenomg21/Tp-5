# Base de datos
# Desarrollo local (SQLite vía @libsql/client):
DATABASE_URL="file:./local.db"
# Producción (Turso): reemplazar DATABASE_URL por libsql://... y completar el token
DATABASE_AUTH_TOKEN=""

# Secreto para firmar la cookie de sesión httpOnly (usar un valor aleatorio largo en producción)
SESSION_SECRET="cambiar-en-produccion-por-una-clave-secreta-de-al-menos-32-caracteres"

# Nombre visible del comercio
NEXT_PUBLIC_APP_NAME="PokéDeck TCG"
